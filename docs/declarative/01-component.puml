@startuml 01-component-diagram
!theme plain
title BoardSync — Діаграма компонентів (модульний моноліт)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 12
skinparam componentStyle uml2
skinparam defaultTextAlignment center
skinparam nodesep 22
skinparam ranksep 50
skinparam ArrowFontSize 10
skinparam component {
  BorderThickness 1.4
  FontSize 13
}
skinparam package {
  BorderColor #34495E
  FontColor #2C3E50
  FontStyle bold
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F1C40F
}

skinparam component<<auth>> {
  BackgroundColor #FDE8E8
  BorderColor #E74C3C
}
skinparam component<<boards>> {
  BackgroundColor #E8F4FD
  BorderColor #3498DB
}
skinparam component<<jira>> {
  BackgroundColor #FFF4E0
  BorderColor #F39C12
}
skinparam component<<realtime>> {
  BackgroundColor #E8F8F0
  BorderColor #27AE60
}
skinparam component<<infra>> {
  BackgroundColor #F2F2F2
  BorderColor #7F8C8D
}

' ===== Клієнт (зверху) =====
package "Клієнт" {
  component "Frontend\n(React SPA)" as FE <<infra>>
}

' ===== Backend: порядок зліва направо підібраний так,\n     щоб більшість залежностей були між сусідами =====
package "Backend — NestJS модульний моноліт\n(один процес, один Docker-контейнер)" as Backend {

  component "Auth Module\n[Денис]" as Auth <<auth>>
  interface "REST\n/auth/*" as IAuth
  Auth -down- IAuth

  component "Jira-Sync Module\n[Едвард]" as Jira <<jira>>
  interface "REST /jira/*\n(webhook)" as IJira
  Jira -down- IJira

  component "Boards & Cards\nModule [Павло]" as Boards <<boards>>
  interface "REST /boards/*\n/cards/*" as IBoards
  Boards -down- IBoards

  component "Internal Event Bus\n(@nestjs/event-emitter)" as Bus <<infra>>
  interface "pub/sub\ncard.moved" as IBus
  Bus -down- IBus

  component "Realtime Module\n[Кирило]" as RT <<realtime>>
  interface "WS\n/realtime" as IRT
  RT -down- IRT
}

' ===== Зовнішні системи (знизу, під тими, хто їх використовує) =====
database "PostgreSQL\n(єдина БД,\nтаблиці по модулях)" as DB <<infra>>
interface "SQL / TypeORM" as IDB
DB -down- IDB

component "Jira Cloud\n(зовнішня система)" as JiraCloud <<infra>>
interface "Jira REST API v3\n+ Webhook" as IJC
JiraCloud -down- IJC

' ================= Залежності =================

' -- Клієнт -> публічні REST/WS інтерфейси модулів (без підписів, дублюють ім'я інтерфейсу) --
FE ..> IAuth
FE ..> IJira
FE ..> IBoards
FE ..> IRT

' -- Прямі внутрішні DI-залежності між модулями (без окремого інтерфейсу — пряма інʼєкція сервісу) --
Jira ..> Auth
Boards ..> Auth
Jira ..> Boards

' -- Залежність від БД --
Auth ..> IDB
Jira ..> IDB
Boards ..> IDB

' -- Залежність від зовнішньої Jira Cloud --
Jira ..> IJC

' -- Подієва взаємодія через Event Bus (тільки тут — fan-out до Realtime) --
Boards .[#E67E22].> IBus : publish
Jira .[#E67E22].> IBus : publish
RT .[#E67E22].> IBus : subscribe

note bottom of Bus
  Подієва шина (помаранчеві стрілки) — лише для
  fan-out "картку змінено → сповістити Realtime".
  Решта міжмодульних залежностей (сірі стрілки) —
  прямі виклики сервісів через DI.
end note

legend right
  |= Позначення |= Значення |
  | суцільна лінія + куля | компонент **надає** інтерфейс |
  | сіра пунктирна стрілка | пряма залежність (DI / REST-виклик) |
  | помаранчева пунктирна стрілка | залежність через Event Bus |
  | колір компонента | модуль = зона відповідальності учасника команди |
endlegend

@enduml
