# =============================================================================
# BoardSync - Production Environment (committed, placeholders only)
# =============================================================================
# Every `${...}` value MUST be provided through CI/CD secrets or the process
# environment. NEVER commit real secrets. There are no fallbacks: a missing
# value makes the application refuse to start.
# =============================================================================

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=${FRONTEND_URL}

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=boardsync
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_NAME=boardsync_prod
DATABASE_LOGGING=false

JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

JIRA_CLIENT_ID=${JIRA_CLIENT_ID}
JIRA_CLIENT_SECRET=${JIRA_CLIENT_SECRET}
# Must be an https:// URL in production
JIRA_REDIRECT_URI=${JIRA_REDIRECT_URI}
JIRA_SCOPES=read:jira-work,write:jira-work,read:jira-user,offline_access

# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=${TOKEN_ENCRYPTION_KEY}

WEBHOOK_SECRET=${WEBHOOK_SECRET}
