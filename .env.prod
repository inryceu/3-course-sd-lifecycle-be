# =============================================================================
# BoardSync - Production Environment (committed, placeholders only)
# =============================================================================
# Every `${...}` value MUST be provided through CI/CD secrets or the process
# environment. NEVER commit real secrets. There are no fallbacks: a missing
# value makes the application refuse to start.
# =============================================================================

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
# Must be an https:// URL in production (validated at startup); it is also the CORS origin.
FRONTEND_URL=${FRONTEND_URL}
# Reverse proxies in front of the API (nginx = 1); keeps per-client rate limits correct.
TRUST_PROXY=1

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=boardsync
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_NAME=boardsync_prod
DATABASE_LOGGING=false

JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

JIRA_CLIENT_ID=${JIRA_CLIENT_ID}
JIRA_CLIENT_SECRET=${JIRA_CLIENT_SECRET}
# Must be an https:// URL in production; the OAuth callback URL is taken from here, not from the forwarded scheme
JIRA_REDIRECT_URI=${JIRA_REDIRECT_URI}
# Public receiver URL; must be https:// in production
JIRA_WEBHOOK_URL=${JIRA_WEBHOOK_URL}
JIRA_SCOPES=read:jira-work,write:jira-work,read:jira-user,manage:jira-webhook,offline_access

# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=${TOKEN_ENCRYPTION_KEY}

WEBHOOK_SECRET=${WEBHOOK_SECRET}
