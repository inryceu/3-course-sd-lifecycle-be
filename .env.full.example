# =============================================================================
# BoardSync - secrets for the full local stack (docker-compose.full.yml)
# =============================================================================
# Copy to `.env.full` (git-ignored) and run:
#   docker compose --env-file .env.full -f docker-compose.full.yml up --build
# NEVER commit `.env.full`. Compose stops with a clear message when a value is missing.
# =============================================================================

# PostgreSQL password (used by both the database and the backend)
DATABASE_PASSWORD=change-me-database-password

# HS256 signing secret, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# AES-256-GCM key for Jira tokens: exactly 64 hex characters. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Shared secret for Jira webhooks, at least 32 characters
WEBHOOK_SECRET=change-me-webhook-secret-of-at-least-32-chars

# Atlassian OAuth 2.0 (3LO) app credentials (https://developer.atlassian.com/console/myapps/).
# The callback URL registered in the app must be http://localhost:8080/jira/callback.
# Placeholders are enough to start the stack; the Jira connect flow needs real values.
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret

# Optional: host ports, change them when 8080 / 3000 are already in use on your machine.
# The Atlassian callback URL must then be http://localhost:<WEB_PORT>/jira/callback
# WEB_PORT=8080
# BACKEND_PORT=3000

# Optional: where the frontend repository is checked out (default ../3-course-sd-lifecycle-fe)
# FRONTEND_CONTEXT=../3-course-sd-lifecycle-fe
# Optional: use a prebuilt frontend image and run `up --no-build`
# FRONTEND_IMAGE=ghcr.io/example/boardsync-frontend:latest
