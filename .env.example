# =============================================================================
# BoardSync - Environment Variables Example
# =============================================================================
# Copy this file to .env.local for local development, or set these variables
# in your CI/CD secrets. NEVER commit real secrets to version control.
# =============================================================================

# =============================================================================
# Application
# =============================================================================
# Environment: development, production, or test
NODE_ENV=development

# Port the application listens on
PORT=3000

# API prefix for all routes
API_PREFIX=api/v1

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Database host (use 'postgres' for Docker Compose, 'localhost' for local)
DATABASE_HOST=localhost

# Database port
DATABASE_PORT=5432

# Database username
DATABASE_USERNAME=postgres

# Database password (use a strong password in production!)
DATABASE_PASSWORD=postgres

# Database name
DATABASE_NAME=boardsync

# Auto-synchronize schema (true for dev, false for prod)
DATABASE_SYNCHRONIZE=true

# Enable SQL query logging
DATABASE_LOGGING=true

# =============================================================================
# JWT Authentication
# =============================================================================
# JWT secret key - MUST be at least 32 characters in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# JWT access token expiration - MUST be <= 1h (3600s) for security
# Format: <number><unit> where unit is s (seconds), m (minutes), h (hours), d (days)
# Examples: 30m, 1h, 3600s
JWT_EXPIRES_IN=1h

# JWT refresh token secret - MUST be at least 32 characters in production!
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars

# JWT refresh token expiration
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Jira OAuth 2.0 (3LO) Integration
# =============================================================================
# Get these from your Jira Cloud app: https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret

# OAuth redirect URI - must match the one configured in your Jira app
JIRA_REDIRECT_URI=http://localhost:3000/api/v1/auth/jira/callback

# Jira OAuth scopes (comma-separated)
JIRA_SCOPES=read:jira-work,write:jira-work,read:jira-user,manage:jira-webhook

# =============================================================================
# Crypto / Encryption
# =============================================================================
# Encryption key for tokens - MUST be exactly 32 bytes (64 hex characters) for AES-256
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-64-hex-chars-here

# =============================================================================
# Webhook Security
# =============================================================================
# Secret for verifying webhook signatures (min 32 chars)
WEBHOOK_SECRET=your-webhook-secret-min-32-chars

# =============================================================================
# WebSocket
# =============================================================================
# WebSocket server port
WS_PORT=3001

# =============================================================================
# Database (PostgreSQL) - Additional settings
# =============================================================================
# Auto-synchronize schema (true for dev, false for prod)
DATABASE_SYNCHRONIZE=true

# Enable SQL query logging
DATABASE_LOGGING=true