# =============================================================================
# BoardSync - Environment Variables Example
# =============================================================================
# Copy to `.env.local` (git-ignored) for local overrides, or set the variables in
# CI/CD secrets. NEVER commit real secrets. Every variable below is validated at
# startup (src/config/validation.schema.ts); the app refuses to start if one is
# missing or invalid. The sample values pass validation.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | production | test
NODE_ENV=development
# HTTP port (Socket.IO shares it)
PORT=3000
# Prefix for all routes
API_PREFIX=api/v1
# Frontend origin, used for CORS
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---------------------------------------------------
# `postgres` inside Docker Compose, `localhost` / `127.0.0.1` otherwise
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
# Use a strong password outside local development
DATABASE_PASSWORD=postgres
DATABASE_NAME=boardsync
# Log SQL queries (true/false)
DATABASE_LOGGING=false
# Connection pool size
DATABASE_POOL_MAX=10
# Note: schema synchronisation does not exist; the schema changes only through migrations.

# --- Authentication ----------------------------------------------------------
# HS256 signing secret, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Access-token lifetime, MUST be <= 1h. Format <number><s|m|h> e.g. 30m, 1h, 3600s
JWT_EXPIRES_IN=1h
# bcrypt cost factor, 10-15 (NFR-SEC-4: at least 10)
BCRYPT_ROUNDS=10

# --- Jira OAuth 2.0 (3LO) ----------------------------------------------------
# From https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret
# Must equal a callback URL registered in the Atlassian app. It points at the FRONTEND
# route that forwards `code` and `state` to GET /jira/oauth/callback. HTTPS required in production.
JIRA_REDIRECT_URI=http://localhost:5173/jira/callback
# Comma-separated scopes; offline_access is needed to receive a refresh token
JIRA_SCOPES=read:jira-work,write:jira-work,read:jira-user,offline_access
# Optional: override Atlassian endpoints (tests use a stub server; HTTPS in production)
# JIRA_AUTH_BASE_URL=https://auth.atlassian.com
# JIRA_API_BASE_URL=https://api.atlassian.com

# --- Encryption --------------------------------------------------------------
# AES-256-GCM key for Jira tokens: exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Webhooks ----------------------------------------------------------------
# Shared secret for verifying Jira webhooks, at least 32 characters
WEBHOOK_SECRET=change-me-webhook-secret-of-at-least-32-chars
